# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# yok3x 런타임 산출물(프로젝트별 생성, 이식 불필요)
.yok3x/
*.log
# 사용자별 생성 설정(정본은 코드의 DEFAULT_YOK3X/DEFAULT_BACKENDS). 도구 소스 리포에선 미추적
/yok3x.json
/backends.json
*.bak

# 로컬 백업: 큰 폴더 스냅샷은 제외, 버전 아카이브(zip+매니페스트)는 추적해 GitHub에도 보존
backup/*
!backup/versions/

# JS 샘플 의존성 / 브라우저 스냅샷(대용량, 소스 아님)
node_modules/
*.mhtml
*.mht

# 임시/스크래치
_extracted/
_protorun*/
*.tmp
.tmp/
.pytest-tmp*/
.pytest_tmp*/
.pytest-temp*/
.pytest_temp*/
.codex-pytest-tmp*/
# 이름 변형이 계속 늘어나서(.pytest-tmp, .s9-pytest-temp, .codex-pytest-tmp...) 개별 접두사
# 추가를 그만두고 포괄 패턴으로 전환(RULE.md §5.7 — 외부 도구가 저장소 루트에 basetemp를 만드는
# 문제, 매번 새 이름으로 뚫림). "pytest"와 "tmp"/"temp"를 모두 포함하는 디렉터리는 이름이 뭐든 무시.
*pytest*tmp*/
*pytest*temp*/
